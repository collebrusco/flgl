# template Makefile
# designed to be Makefile for a project that has flgl at ./lib/flgl

# choose which modules are included
# core gfx & audio
MODULES += coregl
MODULES += coreal
# leaf utility modules
MODULES += math
MODULES += geometry
MODULES += allocators
MODULES += ecs
MODULES += misc
# frameworks
MODULES += driver
MODULES += render

include lib/flgl/flgl.mk

APP    := build/untitled
SRC    := $(shell find src -name '*.cpp')

CXX    ?= g++
CXXSTD := -std=c++20
# OPT    ?=
WARN   := -Wall -Wextra -Wpedantic -Werror=return-type

.PHONY: all
all: $(APP)

$(APP): $(SRC) $(FLGL_LIB)
	@mkdir -p $(dir $@)
	$(CXX) $(CXXSTD) $(OPT) $(WARN) $(FLGL_CPPFLAGS) $(SRC) $(FLGL_LIB) $(FLGL_LDLIBS) -o $@

$(FLGL_LIB): FORCE
	$(MAKE) -C lib/flgl MODULES="$(MODULES)"
FORCE:

.PHONY: flgl
flgl: $(FLGL_LIB)

run: all
	./$(APP)

clean:
	rm -rf build

# shorthands
.PHONY: run clean build c b r cb br cbr

build: all

c: clean
b: build
r: run
cb: c b
br: b r
cbr: c b r
