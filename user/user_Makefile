# =============================================================================
#  your project's Makefile  —  builds your app against flgl (vendored at lib/flgl)
#  installed by lib/flgl/user/setup.sh. all cross-platform knowledge lives in
#  lib/flgl/flgl.mk; keep this file tiny.
#
#    make                    build against the modules listed below
#    make run | make clean
# =============================================================================

# flgl modules
MODULES += coregl		# (foundation)
MODULES += coreal		# (foundation)
MODULES += math			# (foundation)
MODULES += geometry		# (foundation)
MODULES += allocators	# (foundation)
MODULES += ecs			# (foundation)
MODULES += misc			# (foundation)
MODULES += driver		# (framework)
MODULES += render		# (framework)

include lib/flgl/flgl.mk

APP    := build/untitled
SRC    := $(wildcard src/**/*.cpp)

CXX    ?= g++
CXXSTD := -std=c++20
# OPT    ?=
WARN   := -Wall -Wextra -Wpedantic -Werror=return-type

.PHONY: all
all: $(APP)

$(APP): $(SRC) $(FLGL_LIB)
	@mkdir -p $(dir $@)
	$(CXX) $(CXXSTD) $(OPT) $(WARN) $(FLGL_CPPFLAGS) $(SRC) $(FLGL_LIB) $(FLGL_LDLIBS) -o $@

# always delegate the library build to flgl's make
$(FLGL_LIB): FORCE
	$(MAKE) -C lib/flgl MODULES="$(MODULES)"
FORCE:

# and fwd flgl's make to the user
.PHONY: flgl
flgl: $(FLGL_LIB)

# other targets
run: all
	./$(APP)

clean:
	rm -rf build

# shorthands
.PHONY: run clean build c b r cb br cbr

build: all

c: clean
b: build
r: run
cb: c b
br: b r
cbr: c b r
