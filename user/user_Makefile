# =============================================================================
#  your project's Makefile  —  builds your app against flgl (vendored at lib/flgl)
#  installed by lib/flgl/user/setup.sh. all cross-platform knowledge lives in
#  lib/flgl/flgl.mk; keep this file tiny.
#
#    make                    build with all flgl modules
#    make DISABLE=coreal     build without audio
#    make run | make clean
# =============================================================================

# to permanently drop a module, set it here (before the include) instead of on
# the command line, e.g.:  FLGL_DISABLE := coreal
include lib/flgl/flgl.mk

APP    := build/untitled
SRC    := $(wildcard src/*.cpp)

CXX    ?= g++
CXXSTD := -std=c++20
OPT    ?= -O2 -g
WARN   := -Wall -Wextra -Wpedantic -Werror=return-type

.PHONY: all
all: $(APP)

$(APP): $(SRC) $(FLGL_LIB)
	@mkdir -p $(dir $@)
	$(CXX) $(CXXSTD) $(OPT) $(WARN) $(FLGL_CPPFLAGS) $(SRC) $(FLGL_LIB) $(FLGL_LDLIBS) -o $@

# always delegate the library build to flgl's own make (it's correctly
# incremental, and this keeps the module set / DISABLE in sync).
$(FLGL_LIB): FORCE
	$(MAKE) -C lib/flgl DISABLE="$(FLGL_DISABLE)"
FORCE:

# and let the user call it
.PHONY flgl
flgl: $(FLGL_LIB)

.PHONY: run clean build c b r cb br cbr

build: all

c: clean
b: build
r: run
cb: c b
br: b r
cbr: c b r

run: all
	./$(APP)

clean:
	rm -rf build
